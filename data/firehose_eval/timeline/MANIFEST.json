  "schema_version": "1.0",
  "description": "Per-day belief network deltas extracted from firehose pass artifacts. Each day file has belief_deltas (leaf p_before/after), outcome_deltas (per-ticker p_up_before/after + chain), realized_ground_truth, and the apex watchlists.",
  "fields": {
    "belief_deltas[i].belief_id": "belief.company.{template}__ticker_{TKR} or market-scope id",
    "belief_deltas[i].p_before": "leaf p before day-N activations",
    "belief_deltas[i].p_after": "leaf p after day-N activations",
    "belief_deltas[i].delta": "p_after - p_before",
    "belief_deltas[i].n_activations": "how many articles activated this belief on this day",
    "belief_deltas[i].sample_reasoning": "short string from event_classifier",
    "outcome_deltas[i].p_up_before": "0.5 (priors are reset each day in firehose mode)",
    "outcome_deltas[i].p_up_after": "final apex p_up after carnivore aggregation",
    "outcome_deltas[i].delta": "signed; negative = bearish",
    "outcome_deltas[i].top_chain_summary": "top-3 causal_chain contributors"
  }
